# Copiar a .env y generar una SECRET_KEY local antes de ejecutar Django.
# No guardar credenciales reales en este archivo.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# PostgreSQL. El rol necesita el permiso CREATEDB para que Django cree test_<DB_NAME>.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Con DEBUG=True se usa correo a consola; con DEBUG=False, SMTP.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=farmacia@example.invalid

# Fotos privadas de domicilios (spec 08). Vacío = carpeta privado/ del proyecto, fuera de /media/.
# Respaldar esta carpeta junto con la base; nunca se publica ni se versiona.
ARCHIVOS_PRIVADOS_ROOT=

# Mapa y orden de visita (spec 09). Vacío = valores por defecto.
# Origen y fin del recorrido sugerido: el CESFAM San Nicolás (-36.4988773, -72.2123601).
REPARTO_ORIGEN_LATITUD=
REPARTO_ORIGEN_LONGITUD=
# Mapa base (teselas). Debe usar https:// y tener {z}, {x} e {y}. Por defecto, OpenStreetMap; su política exige
# atribución visible y prohíbe la descarga masiva. Para una implementación real, el DESAMU elige el proveedor.
MAPA_TESELAS_URL=
MAPA_TESELAS_ATRIBUCION=
# Zoom máximo que admite el proveedor (1 a 22). OpenStreetMap: 19.
MAPA_ZOOM_MAXIMO=

# Avisos de reparto por correo (spec 12). El destino es el «correo para avisos» del padrón.
# Vacía: se envía a cualquier correo. Opcional: dominios separados por comas, sin subdominios implícitos
# (por ejemplo: example.invalid,prueba.cl), para limitar los envíos a esos dominios.
# En la demo el padrón es sintético: usa buzones de prueba, nunca correos de pacientes reales.
REPARTO_CORREO_DOMINIOS_PERMITIDOS=
# Envío automático de avisos desde el servidor web (spec 12). Vacía o smtp: envía por SMTP en segundo plano;
# simular: correo en memoria (sin enviar); no: desactivado (usar procesar_avisos_reparto a mano).
REPARTO_AVISOS_AUTOMATICOS=
# Aviso del día (enmienda del 12): desde qué hora y hasta qué hora (HH:MM, 24 h) sale «Hoy llega tu reparto».
# Vacías, valen 08:00 y 18:00.
REPARTO_AVISO_DIA_HORA=
REPARTO_AVISO_DIA_LIMITE=

# Servidor de rutas propio OSRM (enmienda del 09). Solo Django lo consulta; nunca se expone a internet.
# Sin la línea, se usa http://127.0.0.1:5000. Con la línea vacía (OSRM_URL=), el servicio queda desactivado y
# el orden se calcula en línea recta, rotulado. Debe ser http:// o https:// con host, sin consulta ni fragmento.
OSRM_URL=http://127.0.0.1:5000
# Segundos de espera por consulta, entre 0.2 y 2.0 (RNF-05: respuesta en 2 s o menos).
OSRM_TIEMPO_ESPERA=1.0

# Reservado para el spec de notificaciones; sin proveedor configurado aún.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=
