# Plantilla sin credenciales. Django lee las variables del proceso, no este archivo.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=cesfam_desarrollo
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
# Puerto configurable de la instancia elegida en cada equipo.
# Ejemplo habitual: 5432. Entorno local validado de la usuaria: 5433.
POSTGRES_PORT=5432
REDIS_CHANNEL_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
