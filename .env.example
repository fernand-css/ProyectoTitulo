# Copiar a .env y generar una SECRET_KEY local antes de ejecutar Django.
# No guardar credenciales reales en este archivo.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# PostgreSQL. El rol necesita el permiso CREATEDB para que Django cree test_<DB_NAME>.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Con DEBUG=True se usa correo a consola; con DEBUG=False, SMTP.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=farmacia@example.invalid

# Fotos privadas de domicilios (spec 08). Vacío = carpeta privado/ del proyecto, fuera de /media/.
# Respaldar esta carpeta junto con la base; nunca se publica ni se versiona.
ARCHIVOS_PRIVADOS_ROOT=

# Mapa y orden de visita (spec 09). Vacío = valores por defecto.
# Origen y fin del recorrido sugerido: el CESFAM San Nicolás (-36.4988773, -72.2123601).
REPARTO_ORIGEN_LATITUD=
REPARTO_ORIGEN_LONGITUD=
# Mapa base (teselas). Debe usar https:// y tener {z}, {x} e {y}. Por defecto, OpenStreetMap; su política exige
# atribución visible y prohíbe la descarga masiva. Para una implementación real, el DESAMU elige el proveedor.
MAPA_TESELAS_URL=
MAPA_TESELAS_ATRIBUCION=
# Zoom máximo que admite el proveedor (1 a 22). OpenStreetMap: 19.
MAPA_ZOOM_MAXIMO=

# Reservado para el spec de notificaciones; sin proveedor configurado aún.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=
